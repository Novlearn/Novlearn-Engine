    "content": "{\"isFlash\": false, \"elements\": [{\"id\": 1780008000001, \"type\": \"text\", \"content\": {\"text\": \"Soit $f$ définie sur $\\\\mathbb{R}$ par $f(x) = @a x^2 + @b x + @c$.\"}}, {\"id\": 1780008000002, \"type\": \"graph\", \"content\": {\"xMax\": 6, \"xMin\": -6, \"yMax\": 15, \"yMin\": -10, \"showGrid\": true, \"functions\": [{\"color\": \"#2563eb\", \"expression\": \"@a*x^2 + @b*x + @c\"}]}}, {\"id\": 1780008000003, \"type\": \"question\", \"content\": {\"hint\": \"Résoudre $f'(x) = 0$. On a $f'(x) = 2 \\\\times @a \\\\times x + @b$.\", \"points\": 1, \"question\": \"En quel point $x_0$ la fonction $f$ admet-elle un minimum ? (donner la valeur de $x_0$)\", \"explanation\": \"$f'(x) = 2@a x + @b = 0 \\\\Leftrightarrow x = \\\\frac{-@b}{2 \\\\times @a}$. Comme $@a > 0$, c'est bien un minimum.\", \"answerFormat\": \"number\", \"correctAnswer\": \"\\\\frac{-@b}{2*@a}\"}}], \"variables\": [{\"id\": 1780008000010, \"max\": 3, \"min\": 1, \"name\": \"a\", \"type\": \"integer\", \"choices\": [], \"decimals\": 2, \"exclusions\": \"\", \"expression\": \"\"}, {\"id\": 1780008000011, \"max\": 6, \"min\": -6, \"name\": \"b\", \"type\": \"integer\", \"choices\": [], \"decimals\": 2, \"exclusions\": \"0\", \"expression\": \"\"}, {\"id\": 1780008000012, \"max\": 5, \"min\": -5, \"name\": \"c\", \"type\": \"integer\", \"choices\": [], \"decimals\": 2, \"exclusions\": \"\", \"expression\": \"\"}], \"needCalculator\": false}",
