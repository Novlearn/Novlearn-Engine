    "title": "Suite récurrente point fixe 1",
    "chapter": "Suites numériques",
    "difficulty": "Moyen",
    "competences": "[\"Utiliser les théorèmes du cours\",\"Etablir la convergence ou divergence d'une suite\"]",
    "content": "{\"isFlash\": false, \"elements\": [{\"id\": 1781009000001, \"type\": \"text\", \"content\": {\"text\": \"Soit la suite définie par $u_0 = @u0$ et $u_{n+1} = \\\\frac{@k}{u_n}$ pour tout $n \\\\in \\\\mathbb{N}$ (avec $u_n > 0$).\"}}, {\"id\": 1781009000002, \"type\": \"question\", \"content\": {\"hint\": \"\", \"points\": 1, \"question\": \"Si la suite converge vers un réel $\\\\ell > 0$, quelle est la valeur de $\\\\ell$ ?\", \"explanation\": \"On peut écrire : $u_{n+1} = f( u_{n} )$, avec $ f ( x ) = \\\\frac{@k}{x} . \\\\newline$\\nComme $\\\\ell > 0$, $f$ est continue en $\\\\ell$ et par passage à la lmite quand $n \\\\to +\\\\infty$ :\\n$\\\\newline \\\\ell = f( \\\\ell ) \\\\Leftrightarrow \\\\ell = \\\\frac{@k}{\\\\ell} \\\\Leftrightarrow \\\\ell^2 = @k\\\\Leftrightarrow \\\\ell = \\\\sqrt{@k}$ (car $\\\\ell > 0$).\", \"answerFormat\": \"number\", \"correctAnswer\": \"\\\\sqrt{@k}\"}}, {\"id\": 1781009000003, \"type\": \"mcq\", \"content\": {\"hint\": \"$u_1 = \\\\frac{@k}{u_0}$, puis $u_2 = \\\\frac{@k}{u_1}$.\", \"options\": [{\"id\": 1, \"text\": \"$u_0$\", \"correct\": true}, {\"id\": 2, \"text\": \"$\\\\frac{@k}{u_0}$\", \"correct\": false}, {\"id\": 3, \"text\": \"$\\\\frac{1}{u_0}$\", \"correct\": false}, {\"id\": 4, \"text\": \"$2 u_0$\", \"correct\": false}], \"question\": \"Que vaut $u_2$ en fonction de $u_0$ ?\", \"explanation\": \"$u_2 = \\\\frac{@k}{u_1} = \\\\frac{@k}{\\\\frac{@k}{u_0}} = u_0$. La suite est 2-périodique !\", \"multipleChoice\": false, \"multipleAnswers\": false}}, {\"id\": 1777470911608, \"type\": \"mcq\", \"content\": {\"options\": [{\"id\": 1, \"text\": \"La suite $(u_n)$ converge\", \"correct\": false}, {\"id\": 2, \"text\": \"La suite $(u_n)$ diverge\", \"correct\": true}, {\"text\": \"On ne peut encore rien conclure\", \"correct\": false}], \"question\": \"Que conclure sur la convergence de $(u_n)$ ?\", \"explanation\": \"La suite $(u_n)$ alterne entre les valeurs de $u_0$ et $u_1$, car $ u_0 = u_2 = u_4 ...$ et de même $u_1 = u_3 = u_5 = ...$.\\n$\\\\newline$ Ainsi comme $u_0 \\\\ne u_1$, la suite $(u_n)$ diverge.\", \"multipleChoice\": false}}], \"variables\": [{\"id\": 1781009000010, \"max\": 15, \"min\": 2, \"name\": \"k\", \"type\": \"integer\", \"choices\": [], \"decimals\": 2, \"exclusions\": \"4;9\", \"expression\": \"\"}, {\"id\": 1781009000011, \"max\": 5, \"min\": 1, \"name\": \"u0\", \"type\": \"integer\", \"choices\": [], \"decimals\": 2, \"exclusions\": \"\", \"expression\": \"\"}], \"needCalculator\": false}",
    "app_title": "Point fixe d'une suite récurrente",
    "Is_Flash": false,
    "Need_Calculator": false
  },
