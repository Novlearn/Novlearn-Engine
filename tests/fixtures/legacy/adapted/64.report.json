    "competences": "[\"Tirer des informations du graphe d'une fonction ou de ses dérivées\"]",
    "content": "{\"apptitle\": \"\", \"elements\": [{\"id\": 1772030408260, \"type\": \"text\", \"content\": {\"text\": \"On considère le graphe d'une fonction $f$ quelconque que l'on admet dérivable :\"}}, {\"id\": 1772030005401, \"type\": \"graph\", \"content\": {\"xMax\": 2, \"xMin\": -2, \"yMax\": 2, \"yMin\": -2, \"showGrid\": true, \"functions\": [{\"color\": \"#6805e1\", \"expression\": \"\\\\sin(2.5 *x^2)\"}]}}, {\"id\": 1772030559994, \"type\": \"question\", \"content\": {\"hint\": \"\", \"points\": 1, \"question\": \"Combien de fois la dérivée de $f$ s'annule-t-elle sur $[-2,2]$?\", \"explanation\": \"Les racines de la dérivée correspondent aux extremums locaux. Ici, on en compte 7, ils correspondent au changement de monotonie de la fonction\", \"answerFormat\": \"number\", \"correctAnswer\": \"7\"}}, {\"id\": 1773846039909, \"type\": \"mcq\", \"content\": {\"options\": [{\"id\": 1, \"text\": \"$f'$ n'est pas de signe constant sur $[0,1]$\", \"correct\": true}, {\"id\": 2, \"text\": \"$f'( 0 ) = 0$\", \"correct\": true}, {\"text\": \"$f$ est une fonction impaire\", \"correct\": false}, {\"text\": \"$f$ est une fonction paire\", \"correct\": true}, {\"text\": \"$f$ est $1$-périodique\", \"correct\": false}, {\"text\": \"$f'$ est négative sur $[- \\\\frac{1}{2} , 0]$\", \"correct\": true}], \"question\": \"Quelle(s) affirmation(s) est(sont) vraie(s) ?\", \"multipleChoice\": true}}], \"variables\": []}",
    "app_title": "Graphique d'une fonction",
    "Is_Flash": false,
