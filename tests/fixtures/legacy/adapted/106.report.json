    "content": "{\"isFlash\": false, \"elements\": [{\"id\": 1780010000001, \"type\": \"text\", \"content\": {\"text\": \"Soit $f$ définie sur $]0 ; +\\\\infty[$ par $f(x) = @a x \\\\ln(x) + @b x$.\"}}, {\"id\": 1780010000002, \"type\": \"question\", \"content\": {\"hint\": \"\", \"points\": 1, \"question\": \"Calculer $f'(x)$ pour $x > 0$.\", \"explanation\": \"$f'(x) = @a (\\\\ln x + 1) + @b = @a \\\\ln(x) + @a + @b$.\", \"answerFormat\": \"expression\", \"correctAnswer\": \"@a * \\\\ln(x) + @a + @b\"}}, {\"id\": 1780010000003, \"type\": \"question\", \"content\": {\"hint\": \"\", \"points\": 1, \"question\": \"Pour quelle valeur de $x$ a-t-on $f'(x) = 0$ ? (Donner le résultat exact sous la forme $e^k$)\", \"explanation\": \"$@a \\\\ln(x) + @a + @b = 0$ $\\\\Leftrightarrow \\\\ln(x) = \\\\frac{-@a-@b}{@a} \\\\Leftrightarrow x = e^{\\\\frac{@c}{@a}}$.\", \"answerFormat\": \"number\", \"correctAnswer\": \"e^{\\\\frac{@c}{@a}}\"}}], \"variables\": [{\"id\": 1780010000010, \"max\": 4, \"min\": 1, \"name\": \"a\", \"type\": \"integer\", \"choices\": [], \"decimals\": 2, \"exclusions\": \"\", \"expression\": \"\"}, {\"id\": 1780010000011, \"max\": 6, \"min\": 1, \"name\": \"b\", \"type\": \"integer\", \"choices\": [], \"decimals\": 2, \"exclusions\": \"@a\", \"expression\": \"\"}, {\"id\": 1778075375953, \"max\": 10, \"min\": 1, \"name\": \"c\", \"type\": \"computed\", \"choices\": [], \"decimals\": 2, \"exclusions\": \"\", \"expression\": \"-@a-@b\"}], \"needCalculator\": false}",
    "app_title": "Dérivée fonction logarithmique",
