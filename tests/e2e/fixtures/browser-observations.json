                "content": {
                  "format": "text",
                  "text": "$2 u_0$"
                }
              }
            ]
          },
          {
            "id": "1777470911608",
            "type": "mcq",
            "text": "Que conclure sur la convergence de $(u_n)$ ?",
            "points": 1,
            "mode": "single",
            "options": [
              {
                "id": "1",
                "content": {
                  "format": "text",
                  "text": "La suite $(u_n)$ converge"
