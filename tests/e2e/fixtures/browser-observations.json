            "response": {
              "format": "latex",
              "kind": "real"
            }
          },
          {
            "id": "1781009000003",
            "type": "mcq",
            "text": "Que vaut $u_2$ en fonction de $u_0$ ?",
            "points": 1,
            "mode": "single",
