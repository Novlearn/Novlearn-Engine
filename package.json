{
  "name": "novlearn-exercise-engine",
  "version": "0.2.1",
  "private": true,
  "description": "Independent NovLearn exercise engine foundations",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-host": {
      "types": "./dist/node-host/index.d.ts",
      "import": "./dist/node-host/index.js"
    },
    "./legacy": {
      "types": "./dist/adapters/legacy/index.d.ts",
      "import": "./dist/adapters/legacy/index.js"
    },
    "./remote-host": {
      "types": "./dist/remote-host/index.d.ts",
      "import": "./dist/remote-host/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "bin": {
    "novlearn-engine": "./dist/node-host/cli.js",
    "novlearn-engine-server": "./dist/node-host/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node tools/copy-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "lint": "eslint .",
    "format": "prettier --write . \"!.cache/**\" \"!.npm-cache/**\"",
    "format:check": "prettier --check . \"!.cache/**\" \"!.npm-cache/**\"",
    "smoke:package": "node tools/package-smoke.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.151.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
